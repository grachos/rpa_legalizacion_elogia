# Silogtran reports API (Render)
API_BASE_URL=https://apis-legalizacion-silogtran.onrender.com
API_KEY=change-me
API_TIMEOUT_SECONDS=300

# General ledger accounts (SAP FV50 registration)
GL_TRAVEL_EXPENSES=6130105595
GL_CASH_TOLLS=6130105530

# Budget positions (CADI transfers)
POSPRE_TRAVEL_EXPENSES=61301055
POSPRE_CASH_TOLLS=6130105530

# Fixed columns of the SAP table
SAP_INDICATOR=V7
SAP_FIXED_ACCOUNT=222222222

# Master data
DRIVERS_FILE=Asignación Conductores.xlsx
DRIVERS_SHEET=CENTROS DE COSTOS FLOTA 

# Output folder
OUTPUT_DIR=output

# SAP GUI (RPA). Active environment: QAS (calidad) or PRD (productivo)
SAP_ENV=QAS
SAP_LANGUAGE=ES

# Quality (QAS): connection = entry name exactly as shown in SAP Logon
SAP_QAS_CONNECTION=
SAP_QAS_CLIENT=
SAP_QAS_USER=
SAP_QAS_PASSWORD=

# Production (PRD)
SAP_PRD_CONNECTION=
SAP_PRD_CLIENT=
SAP_PRD_USER=
SAP_PRD_PASSWORD=

# GR55 balances (RPA)
GR55_REPORT_GROUP=ZFM1
GR55_CC_LOW=25000000
GR55_CC_HIGH=29000000
